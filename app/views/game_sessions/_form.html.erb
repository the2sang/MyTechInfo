<%= form_with model: game_session,
                  url: game_session.persisted? ? game_session_path(game_session) : game_sessions_path,
                  class: "cl-form" do |f| %>
  <%= hidden_field_tag :club_id, @club&.id if @club %>
  <% if game_session.errors.any? %>
    <div class="cl-form__error">
      <% game_session.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
    </div>
  <% end %>

  <div class="cl-form__field">
    <%= f.label :title, "세션 제목", class: "cl-form__label" %>
    <%= f.text_field :title, class: "cl-form__input" %>
  </div>

  <div class="cl-form__grid">
    <div class="cl-form__field">
      <%= f.label :venue_name, "장소명", class: "cl-form__label" %>
      <%= f.text_field :venue_name, class: "cl-form__input" %>
    </div>
    <div class="cl-form__field">
      <%= f.label :address, "주소", class: "cl-form__label" %>
      <%= f.text_field :address, class: "cl-form__input" %>
    </div>
  </div>

  <div class="cl-form__grid cl-form__grid--3">
    <div class="cl-form__field">
      <%= f.label :scheduled_date, "날짜", class: "cl-form__label" %>
      <%= f.date_field :scheduled_date, class: "cl-form__input" %>
    </div>
    <div class="cl-form__field">
      <%= f.label :start_time, "시작 시간", class: "cl-form__label" %>
      <%= f.time_field :start_time, class: "cl-form__input" %>
    </div>
    <div class="cl-form__field">
      <%= f.label :end_time, "종료 시간", class: "cl-form__label" %>
      <%= f.time_field :end_time, class: "cl-form__input" %>
    </div>
    <div class="cl-form__field">
      <%= f.label :court_count, "코트 수", class: "cl-form__label" %>
      <%= f.number_field :court_count, min: 1, class: "cl-form__input" %>
    </div>
    <div class="cl-form__field">
      <%= f.label :fee, "참가비 (원)", class: "cl-form__label" %>
      <%= f.number_field :fee, min: 0, class: "cl-form__input" %>
    </div>
    <div class="cl-form__field">
      <%= f.label :max_participants, "정원", class: "cl-form__label" %>
      <%= f.number_field :max_participants, min: 1, placeholder: "무제한", class: "cl-form__input" %>
    </div>
  </div>

  <div class="cl-form__field">
    <%= f.label :visibility, "공개 설정", class: "cl-form__label" %>
    <%= f.select :visibility, [["공개", "public_visibility"], ["회원 전용", "members_only"]], {}, class: "cl-form__select" %>
  </div>

  <div class="cl-form__field">
    <%= f.label :notes, "메모", class: "cl-form__label" %>
    <%= f.text_area :notes, rows: 3, class: "cl-form__textarea" %>
  </div>

  <%# ── 반복 설정 ──────────────────────────────────────── %>
  <div class="cl-form__section" data-controller="repeat-options">
    <div class="cl-form__section-header">
      <iconify-icon icon="lucide:repeat"></iconify-icon>
      <span>반복 설정</span>
    </div>

    <div class="cl-form__field">
      <%= f.label :repeat_type, "반복 주기", class: "cl-form__label" %>
      <%= f.select :repeat_type,
          [["반복 없음", "no_repeat"], ["매일", "daily"], ["매주 (같은 요일)", "weekly"], ["특정 요일 선택", "specific_days"]],
          {},
          class: "cl-form__select",
          data: { repeat_options_target: "typeSelect", action: "change->repeat-options#toggle" } %>
    </div>

    <div data-repeat-options-target="specificDays" style="display:none;">
      <div class="cl-form__label" style="margin-bottom:8px;">요일 선택</div>
      <div class="repeat-days-grid">
        <% [["일", 0], ["월", 1], ["화", 2], ["수", 3], ["목", 4], ["금", 5], ["토", 6]].each do |label, val| %>
          <label class="repeat-day-btn">
            <input type="checkbox" name="game_session[repeat_days][]" value="<%= val %>"
              <%= "checked" if game_session.repeat_days_array.include?(val) %>
              style="display:none;" data-repeat-options-target="dayCheck">
            <span><%= label %></span>
          </label>
        <% end %>
      </div>
    </div>

    <div data-repeat-options-target="endDate" style="display:none;">
      <div class="cl-form__field" style="margin-top:12px;">
        <%= f.label :repeat_ends_on, "반복 종료일 (선택)", class: "cl-form__label" %>
        <%= f.date_field :repeat_ends_on, class: "cl-form__input" %>
      </div>
    </div>

    <div data-repeat-options-target="notice" style="display:none;"
         class="cl-form__notice">
      <iconify-icon icon="lucide:info"></iconify-icon>
      <span>반복 설정 시 <strong>매일 오전 9시</strong>에 해당 날짜의 운동 세션이 자동으로 등록됩니다. 이 세션은 반복 일정의 <strong>기준 템플릿</strong>으로 저장됩니다.</span>
    </div>
  </div>

  <%= f.submit "저장", class: "cl-form__submit" %>
<% end %>
