<% content_for :title, "동호회 관리" %>

<div class="page">
  <div class="page__header">
    <h1 class="title-collage" aria-label="Clubs">
      <span class="tc-letter tc-1">C</span><span class="tc-letter tc-2">l</span><span class="tc-letter tc-3">u</span><span class="tc-letter tc-4">b</span><span class="tc-letter tc-5">s</span>
    </h1>
    <div class="page__header-actions">
      <%= link_to admin_root_path, class: "btn btn--ghost btn--sm" do %>
        <iconify-icon icon="lucide:arrow-left"></iconify-icon> 대시보드
      <% end %>
    </div>
  </div>

  <div class="admin-stats">
    <div class="admin-stats__card">
      <div class="admin-stats__label">활성 동호회</div>
      <div class="admin-stats__value"><%= @approved_clubs.count %></div>
    </div>
    <div class="admin-stats__card">
      <div class="admin-stats__label">정지된 동호회</div>
      <div class="admin-stats__value" style="color: var(--hcp-danger)"><%= @suspended_clubs.count %></div>
    </div>
    <div class="admin-stats__card">
      <div class="admin-stats__label">전체</div>
      <div class="admin-stats__value"><%= @approved_clubs.count + @suspended_clubs.count %></div>
    </div>
  </div>

  <section class="admin-panel">
    <div class="admin-panel__header">
      <h2 class="admin-panel__title">
        <iconify-icon icon="lucide:check-circle" style="color: var(--hcp-success); vertical-align: -2px;"></iconify-icon>
        활성 동호회
      </h2>
      <span class="admin-badge" style="background: var(--hcp-success); color: #fff;"><%= @approved_clubs.count %></span>
    </div>

    <% if @approved_clubs.any? %>
      <table class="admin-table">
        <thead>
          <tr>
            <th>동호회명</th>
            <th>개설자</th>
            <th>개설일</th>
            <th>상태</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @approved_clubs.each do |club| %>
            <tr>
              <td>
                <%= link_to admin_club_path(club), style: "font-weight: 600; color: var(--hcp-black); text-decoration: none;" do %>
                  <%= club.name %>
                <% end %>
              </td>
              <td class="admin-table__mono"><%= club.owner.nickname %></td>
              <td class="admin-table__mono"><%= club.created_at.strftime("%Y-%m-%d") %></td>
              <td><span class="admin-badge" style="background: #dcfce7; color: #15803d;">ACTIVE</span></td>
              <td style="text-align: right;">
                <%= button_to admin_club_path(club), method: :patch, params: { status: "suspended" },
                    class: "btn btn--ghost btn--sm",
                    style: "color: var(--hcp-danger); border-color: var(--hcp-danger);",
                    data: { turbo_confirm: "#{club.name} 동호회를 정지하시겠습니까?" } do %>
                  <iconify-icon icon="lucide:pause-circle"></iconify-icon> 정지
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="empty-state">활성 동호회가 없습니다.</p>
    <% end %>
  </section>

  <section class="admin-panel" style="border-color: #fecaca;">
    <div class="admin-panel__header">
      <h2 class="admin-panel__title">
        <iconify-icon icon="lucide:pause-circle" style="color: var(--hcp-danger); vertical-align: -2px;"></iconify-icon>
        정지된 동호회
      </h2>
      <span class="admin-badge" style="background: var(--hcp-danger-bg); color: var(--hcp-danger);"><%= @suspended_clubs.count %></span>
    </div>

    <% if @suspended_clubs.any? %>
      <table class="admin-table">
        <thead>
          <tr>
            <th>동호회명</th>
            <th>개설자</th>
            <th>개설일</th>
            <th>상태</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @suspended_clubs.each do |club| %>
            <tr style="background: var(--hcp-danger-bg);">
              <td style="font-weight: 600;"><%= club.name %></td>
              <td class="admin-table__mono"><%= club.owner.nickname %></td>
              <td class="admin-table__mono"><%= club.created_at.strftime("%Y-%m-%d") %></td>
              <td><span class="admin-badge" style="background: #fee2e2; color: var(--hcp-danger);">SUSPENDED</span></td>
              <td style="text-align: right;">
                <%= button_to admin_club_path(club), method: :patch, params: { status: "approved" },
                    class: "btn btn--primary btn--sm" do %>
                  <iconify-icon icon="lucide:play-circle"></iconify-icon> 활성화
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="empty-state">정지된 동호회가 없습니다.</p>
    <% end %>
  </section>
</div>
