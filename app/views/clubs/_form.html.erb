<%= form_with model: club, class: "cl-form" do |f| %>
  <% if club.errors.any? %>
    <div class="cl-form__error">
      <% club.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="cl-form__field">
    <%= f.label :name, "동호회 이름", class: "cl-form__label" %>
    <%= f.text_field :name, class: "cl-form__input" %>
  </div>

  <div class="cl-form__field">
    <%= f.label :description, "소개", class: "cl-form__label" %>
    <%= f.text_area :description, rows: 4, class: "cl-form__textarea" %>
  </div>

  <div class="cl-form__grid">
    <div class="cl-form__field">
      <%= f.label :contact_email, "관리자 이메일", class: "cl-form__label" %>
      <%= f.email_field :contact_email, class: "cl-form__input", placeholder: "admin@example.com" %>
      <p style="margin-top:4px; font-size:11px; color:var(--hcp-cool-gray);">이 이메일로 가입한 회원이 자동으로 관리자가 됩니다.</p>
    </div>
    <div class="cl-form__field">
      <%= f.label :contact_phone, "연락처", class: "cl-form__label" %>
      <%= f.telephone_field :contact_phone, class: "cl-form__input", placeholder: "010-0000-0000" %>
    </div>
  </div>

  <%= f.submit "저장", class: "cl-form__submit" %>
<% end %>
