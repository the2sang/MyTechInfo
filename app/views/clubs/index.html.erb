<% content_for :title, "동호회" %>

<div class="cl-page">
  <div class="cl-hero">
    <div class="cl-hero__inner">
      <div class="cl-hero__row">
        <div>
          <p class="cl-hero__eyebrow">Club</p>
          <h1 class="cl-hero__title">동호회 목록</h1>
          <p class="cl-hero__subtitle">함께 운동하고 성장하는 커뮤니티를 찾아보세요.</p>
        </div>
        <%= link_to new_club_path, class: "btn btn--primary btn--sm" do %>
          <iconify-icon icon="lucide:plus" width="13"></iconify-icon>
          동호회 개설 신청
        <% end %>
      </div>
    </div>
  </div>

  <div class="cl-content">
    <% if @clubs.empty? %>
      <div class="cl-empty">
        <div class="cl-empty__icon">
          <iconify-icon icon="lucide:users" width="20"></iconify-icon>
        </div>
        <p class="cl-empty__text">아직 등록된 동호회가 없습니다.</p>
      </div>
    <% else %>
      <div class="cl-grid">
        <% @clubs.each do |club| %>
          <%= link_to club_path(club), class: "cl-card" do %>
            <div class="cl-card__top">
              <div class="cl-card__icon">
                <iconify-icon icon="lucide:users" width="16"></iconify-icon>
              </div>
              <span class="cl-badge cl-badge--neutral">회원 <%= club.club_memberships.approved.count %>명</span>
            </div>
            <p class="cl-card__name"><%= club.name %></p>
            <p class="cl-card__desc"><%= club.description.presence || "소개가 없습니다." %></p>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
