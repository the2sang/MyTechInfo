<% content_for :title, "기본 정보 등록" %>

<div class="cl-page">
  <div class="cl-content cl-content--narrow">
    <div style="margin-bottom:32px;">
      <h1 class="cl-hero__title">기본 정보 등록</h1>
      <p class="cl-hero__subtitle">운동 세션 참가 신청에 필요한 기본 정보를 입력해 주세요.</p>
    </div>

    <div class="cl-form-card">
      <%= form_with model: @user, url: profile_path, method: :patch, class: "cl-form" do |f| %>
        <% if @user.errors.any? %>
          <div class="cl-form__error">
            <% @user.errors.full_messages.each do |msg| %>
              <p><%= msg %></p>
            <% end %>
          </div>
        <% end %>

        <div class="cl-form__grid">
          <div class="cl-form__field">
            <label class="cl-form__label cl-form__label--required">이름</label>
            <%= f.text_field :display_name, class: "cl-form__input", placeholder: "실명을 입력해 주세요", required: true %>
          </div>
          <div class="cl-form__field">
            <label class="cl-form__label">닉네임</label>
            <%= f.text_field :nickname, class: "cl-form__input", value: @user.nickname, disabled: true %>
            <p style="margin-top:4px;font-size:11px;color:var(--hcp-cool-gray);">닉네임은 계정 설정에서 변경할 수 있습니다.</p>
          </div>
        </div>

        <div class="cl-form__field">
          <label class="cl-form__label cl-form__label--required">운동 레벨</label>
          <%= f.select :sport_level,
                [["초급", "beginner"], ["초중급", "beginner_intermediate"], ["중급", "intermediate"],
                 ["중상급", "intermediate_advanced"], ["상급", "advanced"]],
                { selected: @user.sport_level },
                class: "cl-form__select" %>
        </div>

        <div class="cl-form__grid">
          <div class="cl-form__field">
            <label class="cl-form__label cl-form__label--required">성별</label>
            <%= f.select :gender,
                  [["선택 안함", "unspecified"], ["남성", "male"], ["여성", "female"]],
                  { selected: @user.gender },
                  class: "cl-form__select" %>
          </div>
          <div class="cl-form__field">
            <label class="cl-form__label cl-form__label--required">연령대</label>
            <%= f.select :age_group,
                  [["10대", "teens"], ["20대", "twenties"], ["30대", "thirties"],
                   ["40대", "forties"], ["50대", "fifties"], ["60대 이상", "sixties_plus"]],
                  { selected: @user.age_group },
                  class: "cl-form__select" %>
          </div>
        </div>

        <div class="cl-form__field">
          <label class="cl-form__label">거주지역</label>
          <%= f.text_field :region, class: "cl-form__input", placeholder: "예) 용인시 기흥구" %>
        </div>

        <div class="cl-form__field">
          <label class="cl-form__label">DUPR ID</label>
          <%= f.text_field :dupr_id, class: "cl-form__input", placeholder: "예) 1234567" %>
          <% if @user.dupr_rating.present? %>
            <p style="margin-top:6px;font-size:13px;color:var(--hcp-cool-gray);">
              현재 DUPR 레이팅:
              <strong style="color:var(--color-text)"><%= @user.dupr_rating %></strong>
              <span style="font-size:11px;">(마지막 동기화: <%= @user.dupr_last_synced_at.strftime("%Y-%m-%d %H:%M") %>)</span>
            </p>
          <% elsif @user.dupr_id.present? %>
            <p style="margin-top:6px;font-size:12px;color:var(--hcp-cool-gray);">레이팅 동기화 중...</p>
          <% else %>
            <p style="margin-top:4px;font-size:11px;color:var(--hcp-cool-gray);">
              DUPR ID 입력 후 저장하면 레이팅이 자동으로 가져와집니다.
              <a href="https://mydupr.com" target="_blank" style="color:var(--color-primary);">mydupr.com</a>에서 확인하세요.
            </p>
          <% end %>
        </div>

        <div class="cl-form__actions">
          <%= f.submit "저장하기", class: "cl-form__submit" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
